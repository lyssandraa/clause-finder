# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=your-api-key-here

# Optional: which model to use (default: claude-opus-5-5).
# Names starting with "claude" use the Anthropic API. Anything else, such as
# qwen3:8b, runs locally through Ollama and needs no API key.
# Changing the model changes the cache key, so it triggers new model calls.
CLAUSE_FINDER_MODEL=claude-opus-5-5

# Optional: where Ollama is running (default: http://localhost:11434).
# OLLAMA_URL=http://localhost:11434

# Optional: reasoning effort: low | medium | high | xhigh | max (default: medium).
CLAUSE_FINDER_EFFORT=medium
